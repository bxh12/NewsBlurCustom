# NewsBlur Self-Hosted Configuration
# Copy this file to .env and customize for your deployment

# ===== REQUIRED =====
# The public URL of your NewsBlur instance
NEWSBLUR_URL=https://localhost

# Domain for cookies and CSRF protection
# Default: extracted from NEWSBLUR_URL
SESSION_COOKIE_DOMAIN=localhost
PUSH_DOMAIN=localhost

# ===== OPTIONAL: Tailscale =====
# Uncomment and set if using Tailscale for deployment
# TAILSCALE_IP=100.xx.xx.xx
# DISABLE_SUBDOMAINS=true

# ===== OPTIONAL: AI Features =====
# Uncomment any of these to enable AI features
# Leave blank or commented to disable
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_GEMINI_API_KEY=...
# XAI_API_KEY=...

# Specify which model to use for "Ask AI" feature
# Examples: gpt-4, claude-3-opus, gemini-2.0-flash
# ASK_AI_MODEL=

# Specify which model to use for AI-generated briefings
# BRIEFING_MODEL=

# ===== OPTIONAL: Docker Build =====
# Set to False to skip asset compilation during build
RUNWITHMAKEBUILD=True

# Base image variant (python3 or python3.11, etc)
# NEWSBLUR_BASE=python3
